			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1903000000013</Id>
					<Name><![CDATA[interarrivalTime]]></Name>
					<X>710</X><Y>500</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[mean_s]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[return random_arrival_times
	? -Math.log(1.0 - timing_rng.nextDouble()) * mean_s
	: mean_s;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1903000000014</Id>
					<Name><![CDATA[serviceTime]]></Name>
					<X>710</X><Y>520</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[mean_s]]></Name>
						<Type><![CDATA[double]]></Type>
					</Parameter>
					<Body><![CDATA[if (!random_service_times) {
	return mean_s;
}
double spread = service_time_triangular_spread;
double low = mean_s * (1.0 - spread);
double high = mean_s * (1.0 + spread);
double mode = mean_s;
double u = timing_rng.nextDouble();
double c = (mode - low) / (high - low);
return u <= c
	? low + Math.sqrt(u * (high - low) * (mode - low))
	: high - Math.sqrt((1.0 - u) * (high - low) * (high - mode));]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1903000100009</Id>
					<Name><![CDATA[recordDiagnosticEvent]]></Name>
					<X>710</X><Y>540</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[event_name]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[details]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (diagnostic_trace_count >= diagnostic_trace_limit) {
	return;
}
diagnostic_trace += "t=" + time() + ",event=" + event_name
	+ (details == null || details.isEmpty() ? "" : "," + details)
	+ "\n";
diagnostic_trace_count++;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[void]]></ReturnType>
					<Id>1903000100023</Id>
					<Name><![CDATA[recordFlowDebugEvent]]></Name>
					<X>710</X><Y>560</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[event_name]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[details]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (flow_debug_trace_count >= flow_debug_trace_limit) {
	return;
}
flow_debug_trace += "t=" + time() + ",event=" + event_name
	+ (details == null || details.isEmpty() ? "" : "," + details)
	+ "\n";
flow_debug_trace_count++;]]></Body>
				</Function>
			</Functions>
