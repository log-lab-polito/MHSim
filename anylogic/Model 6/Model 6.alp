recordFlowDebugEvent("unbatch_station_process_started",
	"main_occ=" + main_conveyor_occupancy_end
	+ ",storage_occ=" + storage_conveyor_occupancy_end);
int itemsCount = unbatch_rng.nextInt(pallet.current_nof_items) + 1;
recordDiagnosticEvent("unbatch_started", "current_nof_items=" + pallet.current_nof_items);
loose_items_created += itemsCount;
recordDiagnosticEvent("loose_items_injected", "items_count=" + itemsCount);
looseItemSource.inject(itemsCount);
]]></Code>
