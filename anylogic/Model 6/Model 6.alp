			<Name><![CDATA[Main]]></Name>
			<StartupCode><![CDATA[item_count_rng = new Random(item_count_random_seed);
unbatch_rng = new Random(unbatch_random_seed);
timing_rng = new Random(timing_random_seed);

if (random_arrival_times || random_service_times) {
	stochastic_log_file.println();
	stochastic_log_file.println("ITERATION #" + iteration + ", REPLICATION #" + replication);
	stochastic_log_file.println("PARAMETERS");
	stochastic_log_file.println("    Arrival rate (s): " + arrival_rate_s);
	stochastic_log_file.println("    Service1 time (s): " + service1_time_s);
	stochastic_log_file.println("    Service2 time (s): " + service2_time_s);
	stochastic_log_file.println("    Conveyor Speed (m/s): " + conveyor_speed_ms);
	stochastic_log_file.println("    Conveyor Gap (m): " + conveyor_gap_m);
	stochastic_log_file.println("    Min items per pallet: " + min_items_per_pallet);
	stochastic_log_file.println("    Max items per pallet: " + max_items_per_pallet);
	stochastic_log_file.println("    Item count seed: " + item_count_random_seed);
	stochastic_log_file.println("    Unbatch seed: " + unbatch_random_seed);
	stochastic_log_file.println("    Timing seed: " + timing_random_seed);
	stochastic_log_file.println("    Random arrivals: " + random_arrival_times);
	stochastic_log_file.println("    Random services: " + random_service_times);
} else {
	log_file.println();
	log_file.println("ITERATION #" + iteration);
	log_file.println("PARAMETERS");
	log_file.println("    Arrival rate (s): " + arrival_rate_s);
	log_file.println("    Service1 time (s): " + service1_time_s);
	log_file.println("    Service2 time (s): " + service2_time_s);
	log_file.println("    Conveyor Speed (m/s): " + conveyor_speed_ms);
	log_file.println("    Conveyor Gap (m): " + conveyor_gap_m);
	log_file.println("    Min items per pallet: " + min_items_per_pallet);
	log_file.println("    Max items per pallet: " + max_items_per_pallet);
	log_file.println("    Item count seed: " + item_count_random_seed);
	log_file.println("    Unbatch seed: " + unbatch_random_seed);
	log_file.println("    Timing seed: " + timing_random_seed);
}
]]></StartupCode>
			<DestroyCode><![CDATA[if (random_arrival_times || random_service_times) {
	stochastic_log_file.println("RESULTS");
	stochastic_log_file.println("    Created: " + created_count);
	stochastic_log_file.println("    Completed: " + completed_count);
	stochastic_log_file.println("    Avg WIP: " + (completed_count > 0 && cycle_time_samples > 0 ? (completed_count / time()) * (total_cycle_time_s / cycle_time_samples) : 0.0));
	stochastic_log_file.println("    Avg cycle (s): " + (cycle_time_samples > 0 ? total_cycle_time_s / cycle_time_samples : Double.NaN));
	stochastic_log_file.println("    Throughput (/h): " + (completed_count * 3600.0 / time()));
	stochastic_log_file.println("    Main conveyor occupancy end: " + main_conveyor_occupancy_end);
	stochastic_log_file.println("    Storage conveyor occupancy end: " + storage_conveyor_occupancy_end);
	stochastic_log_file.println("    Empty pallets completed: " + empty_pallets_completed);
	stochastic_log_file.println("    Loose items created: " + loose_items_created);
	stochastic_log_file.println("    Batches created: " + batches_created);
	diagnostic_log_file.println();
	diagnostic_log_file.println("ITERATION #" + iteration + ", REPLICATION #" + replication);
	diagnostic_log_file.println(diagnostic_trace);
	flow_debug_log_file.println();
	flow_debug_log_file.println("ITERATION #" + iteration + ", REPLICATION #" + replication);
	flow_debug_log_file.println(flow_debug_trace);
} else {
	log_file.println("RESULTS");
	log_file.println("    Created: " + created_count);
	log_file.println("    Completed: " + completed_count);
	log_file.println("    Avg WIP: " + (completed_count > 0 && cycle_time_samples > 0 ? (completed_count / time()) * (total_cycle_time_s / cycle_time_samples) : 0.0));
	log_file.println("    Avg cycle (s): " + (cycle_time_samples > 0 ? total_cycle_time_s / cycle_time_samples : Double.NaN));
	log_file.println("    Throughput (/h): " + (completed_count * 3600.0 / time()));
	log_file.println("    Main conveyor occupancy end: " + main_conveyor_occupancy_end);
	log_file.println("    Storage conveyor occupancy end: " + storage_conveyor_occupancy_end);
	log_file.println("    Empty pallets completed: " + empty_pallets_completed);
	log_file.println("    Loose items created: " + loose_items_created);
	log_file.println("    Batches created: " + batches_created);
	diagnostic_log_file.println();
	diagnostic_log_file.println("ITERATION #" + iteration);
	diagnostic_log_file.println(diagnostic_trace);
	flow_debug_log_file.println();
	flow_debug_log_file.println("ITERATION #" + iteration);
	flow_debug_log_file.println(flow_debug_trace);
}]]></DestroyCode>
