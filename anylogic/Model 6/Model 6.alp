					<Parameters>
						<Parameter>
							<Name><![CDATA[onEnter]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[Pallet p = (Pallet)agent;
total_cycle_time_s += time() - p.cycle_start_time;
cycle_time_samples++;
completed_count++;
recordDiagnosticEvent("completed_pallet_sink_enter", "cycle_time_s=" + (time() - p.cycle_start_time));]]></Code>
							</Value>
